{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    //"ignoreDeprecations": "6.0",
    "rootDir": "src",
    "outDir": "./out-tsc/app",

    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Node",

    "lib": ["ES2022", "DOM"],
    "types": [],

    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": false
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "node_modules"
  ]
}
