{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",              // <-- REQUIRED to fix TS6 warning
    "outDir": "./out-tsc/spec",      // compiled test files go here
    "target": "ES2022",              
    "module": "NodeNext",            // required for Karma/Jasmine tests
    "moduleResolution": "NodeNext",    // TypeScript 5+ recommended
    "lib": ["ES2022", "DOM"],
    "types": ["jasmine", "node"],    // for tests + Node globals
    "strict": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}